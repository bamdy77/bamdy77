# ═══════════════════════════════════════════════════════════════════════
# Mikumbi — Frontend environment variables (set them in Vercel →
# Project → Settings → Environment Variables, then redeploy).
# Vite only reads variables that start with VITE_ at BUILD time.
# ═══════════════════════════════════════════════════════════════════════

# Full URL of the backend API on Render (must end with /api)
VITE_API_URL=https://your-backend.onrender.com/api

# Hostnames that are the PUBLIC school website (parents / students).
# Any other hostname (staff.your-domain.com, *.vercel.app, localhost) is the STAFF site.
VITE_PUBLIC_HOSTS=your-domain.com,www.your-domain.com

# Contact details shown on the public site (optional - sensible defaults exist)
VITE_CONTACT_EMAIL=support@mikumbisecondary.com
VITE_CONTACT_PHONES=0685905334,0718197560

# Social media (optional). If none are set, the "Follow Us" block is hidden.
# VITE_SOCIAL_FACEBOOK=https://facebook.com/...
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/...
# VITE_SOCIAL_YOUTUBE=https://youtube.com/...

# Testing only - force a site regardless of hostname: public | staff
# VITE_FORCE_SITE=public

# School location for the map on the parents' site (optional - defaults to
# the school's own coordinates, the same point TAMS uses)
# VITE_SCHOOL_LAT=-10.561915
# VITE_SCHOOL_LNG=39.178560
