# ═══════════════════════════════════════════════════════════════════════
# Mikumbi Secondary School — Backend Environment Variables
# Copy this file to ".env" in the same folder and fill in the real values.
# NEVER commit the real ".env" file to GitHub/version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Server ──
PORT=5000
NODE_ENV=production
# The exact URL of your deployed frontend (used in password-reset email links)
# This is the STAFF site (teachers log in here; password-reset links point here).
FRONTEND_URL=https://staff.your-domain.com
# Every website allowed to call this API, comma-separated, NO trailing slashes.
# Include the public site (with and without www) AND the staff site.
# (Until your domain is ready you can also add your .vercel.app URL here.)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://staff.your-domain.com

# ── Database (Neon.tech Postgres) ──
# Neon dashboard → your project → "Connection string" (choose "Pooled connection")
# Must include ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# ── JWT (login tokens) ──
# Any long random string — e.g. generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Cloudinary (photos + PDFs: student photos, published results, timetables) ──
# Cloudinary dashboard → Home → these three values are shown at the top.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Gmail (password reset emails) ──
# 1. Use/create a Gmail account for the school.
# 2. Turn on 2-Step Verification: myaccount.google.com/security
# 3. Create an App Password: myaccount.google.com/apppasswords
#    (choose "Mail" + "Other", name it "Mikumbi System") — copy the 16-character code.
GMAIL_USER=school-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── TAMS (GPS attendance) ──
# IMPORTANT: verify these match your school's real location, or teachers
# will be unable to check in. Get exact coordinates by opening Google Maps,
# right-clicking the school's main gate/office, and copying the numbers shown
# (e.g. "-10.561915, 39.178560" → latitude first, longitude second).
TAMS_SCHOOL_LAT=-10.561915
TAMS_SCHOOL_LNG=39.178560
# Allowed distance from that point, in metres
TAMS_SCHOOL_RADIUS_M=45
# Check-in window and late cutoff (24-hour, Tanzania time)
TAMS_WINDOW_OPEN_HOUR=6
TAMS_WINDOW_CLOSE_HOUR=8
TAMS_DEADLINE_HOUR=7
TAMS_DEADLINE_MIN=30

# ── NextSMS (Tanzania SMS gateway, for Communications → SMS Service) ──
# Sign up at https://messaging-service.co.tz — dashboard gives you these.
NEXTSMS_USERNAME=your-nextsms-username
NEXTSMS_PASSWORD=your-nextsms-password
NEXTSMS_SENDER_ID=Millanzi
